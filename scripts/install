#!/bin/sh
# Links the share mods into herdr-app and installs the engine on PATH.
# Mods are symlinked, so edits here hot-reload in the app.
set -eu
cd "$(dirname "$0")/.."
dest="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods"
mkdir -p "$dest"
for m in mods/*/; do
  name=$(basename "$m")
  ln -sfn "$PWD/mods/$name" "$dest/$name"
  echo "linked $dest/$name"
done
if command -v cargo >/dev/null 2>&1; then
  cargo install --quiet --path engine
  echo "installed herdr-session: $(command -v herdr-session || echo "add ~/.cargo/bin to PATH")"
else
  echo "cargo not installed: engine skipped (the mods will say herdr-session is missing)"
fi
