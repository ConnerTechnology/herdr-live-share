#!/bin/sh
# Checks the mods (herdr-app check, engine.js copies identical) and the engine (cargo test).
set -eu
cd "$(dirname "$0")/.."
first=""
for m in mods/*/; do
  if [ -z "$first" ]; then first="$m/engine.js"; elif ! cmp -s "$first" "$m/engine.js"; then
    echo "engine.js differs: $m (copy $first to every mod)"; exit 1; fi
  herdr-app check "$m" 2>&1 | grep -E '^(check passed|error|Error)' || { echo "check failed: $m"; exit 1; }
done
cargo=$(command -v cargo || echo "$HOME/.cargo/bin/cargo")
if [ -x "$cargo" ]; then "$cargo" test --quiet; else echo "cargo not installed: engine not checked"; fi
